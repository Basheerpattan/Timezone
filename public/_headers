# Cloudflare serves everything under .open-next/assets straight from the edge,
# bypassing the Worker — which also bypasses the headers() block in
# next.config.mjs. These rules are the Cloudflare equivalent.

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Generated data, rebuilt only by scripts/generate-places.mjs. 6 MB, so it is
# worth never fetching twice.
/places.txt
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: text/plain; charset=utf-8
